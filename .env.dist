# Authentication Mode: "client" (Local Windows Steam Client IPC) or "agent" (Headless Docker/Linux Direct Sign-in)
LOGIN_MODE=client

# Auto-run pending tasks in tasks.json when the Docker container starts (default: true)
TASK_AUTO_RUN=true

# Steam Web API Credentials (REQUIRED: Used for library sync)
STEAM_ID=76561198000000000
STEAM_API_KEY=0123456789ABCDEF0123456789ABCDEF

# Steam Path (REQUIRED FOR CLIENT MODE: Used when LOGIN_MODE=client)
STEAM_PATH="C:\Program Files (x86)\Steam\steam.exe"

# Steam Account Credentials (REQUIRED FOR AGENT MODE: Used when LOGIN_MODE=agent)
STEAM_USERNAME=
STEAM_PASSWORD=
